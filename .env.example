# Copia este archivo a ".env" y rellena tus claves reales.
# Mientras BIGBUY_API_KEY esté vacía, la tienda muestra un catálogo de ejemplo (mock).
# Mientras STRIPE_SECRET_KEY esté vacía, "Finalizar compra" funciona en modo demo (sin cobro real).

PORT=3000
SITE_URL=http://localhost:3000

BIGBUY_API_KEY=
BIGBUY_API_BASE=https://api.bigbuy.eu

STRIPE_SECRET_KEY=

# Webhook de Stripe (Dashboard > Developers > Webhooks > Add endpoint):
# URL: https://tu-dominio.com/webhook/stripe, evento: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Login con Google: crea las credenciales en https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# Email con el que inicias sesión con Google como administrador: es el único que
# puede ver /pedidos.html (panel interno con los pedidos pagados de Stripe).
ADMIN_EMAIL=
